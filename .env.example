# Salin ke .env dan isi nilainya. JANGAN commit file .env.
# Komentar sengaja ditulis di baris sendiri (bukan di belakang nilai).

# --- Database ---
POSTGRES_USER=direkapin
POSTGRES_DB=direkapin
# Acak, min. 32 karakter: openssl rand -hex 16
POSTGRES_PASSWORD=
# Ganti <POSTGRES_PASSWORD>. Pakai host "localhost" saat backend dijalankan di luar Docker.
DATABASE_URL=postgresql://direkapin:<POSTGRES_PASSWORD>@db:5432/direkapin

# --- Auth ---
# Acak, 64 karakter: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Server ---
PORT=3000
NODE_ENV=production
TZ=Asia/Jakarta
LOG_LEVEL=info

# --- Storage ---
UPLOAD_DIR=/data/uploads
ARCHIVE_DIR=/data/archives
BACKUP_DIR=/data/backups
# 2 MB
MAX_UPLOAD_BYTES=2097152

# --- Cloudflare Tunnel ---
# Dari Cloudflare Zero Trust > Networks > Tunnels
CF_TUNNEL_TOKEN=

# --- Aplikasi ---
LATEST_APK_VERSION=1.0.0
LATEST_APK_URL=https://github.com/Ketoprakenak/direkapin/releases/latest
